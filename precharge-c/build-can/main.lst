 463:Core/Src/main.c **** 
 464:Core/Src/main.c **** void controllerQualify(Controller *self, uint32_t nowMS) {
 465:Core/Src/main.c ****   if (!self->bms.valid) {
 466:Core/Src/main.c ****     self->consecutiveQualifying = 0;
 467:Core/Src/main.c ****     return;
 468:Core/Src/main.c ****   }
 469:Core/Src/main.c ****   if (elapsed(nowMS, self->bms.timestamp) >= self->config.freshnessTimeoutMS) {
 470:Core/Src/main.c ****     controllerLatch(self, STALE_BMS);
 471:Core/Src/main.c ****     return;
 472:Core/Src/main.c ****   }
 473:Core/Src/main.c **** 
 474:Core/Src/main.c ****   // Calculate 90% check
 475:Core/Src/main.c ****   uint64_t lhs = (uint64_t)self->inverter.value * 100ULL;
 476:Core/Src/main.c ****   uint64_t rhs = (uint64_t)self->bms.value * self->config.thresholdPercent;
 477:Core/Src/main.c **** 
 478:Core/Src/main.c ****   if (self->state == COMPLETE && self->inverter.value < 200) {
 479:Core/Src/main.c ****     self->state = PRECHARGING;
 480:Core/Src/main.c ****     return;
 481:Core/Src/main.c ****   }
 482:Core/Src/main.c **** 
 483:Core/Src/main.c ****   // 3 count check
 484:Core/Src/main.c ****   if (lhs >= rhs) {
 485:Core/Src/main.c ****     self->consecutiveQualifying++;
 486:Core/Src/main.c ****     if (self->consecutiveQualifying >= self->config.qualifyingSamples) {
 487:Core/Src/main.c ****       self->state = COMPLETE;
 488:Core/Src/main.c ****     }
 489:Core/Src/main.c ****   } else {
 490:Core/Src/main.c ****     self->consecutiveQualifying = 0;
 491:Core/Src/main.c ****   }
 492:Core/Src/main.c **** }
 493:Core/Src/main.c **** 
 494:Core/Src/main.c **** void ingestController(Controller *self, const Frame *frame, uint32_t nowMS) {
 495:Core/Src/main.c ****   if (matchSpec(frame, self->config.bms)) {
 496:Core/Src/main.c ****     bool cart = false;
 497:Core/Src/main.c ****     DecodeError cartError = checkCart(frame, self->config.bms, &cart);
 498:Core/Src/main.c ****     if (cartError != OK) {
 499:Core/Src/main.c ****       controllerLatch(self, MALFORMED_FRAME);
 500:Core/Src/main.c ****       return;
 501:Core/Src/main.c ****     }
 502:Core/Src/main.c ****     if (self->state == WAITING_FOR_BMS && cart) {
 503:Core/Src/main.c ****       self->state = COMPLETE;
 504:Core/Src/main.c ****       return;
 505:Core/Src/main.c ****     }
 506:Core/Src/main.c ****     uint32_t value = 0;
 507:Core/Src/main.c ****     if (decodeVoltage(frame, self->config.bms, &value) != OK) {
 508:Core/Src/main.c ****       controllerLatch(self, MALFORMED_FRAME);
 509:Core/Src/main.c ****       return;
 510:Core/Src/main.c ****     }
 511:Core/Src/main.c ****     self->bms.value = value;
 512:Core/Src/main.c ****     self->bms.timestamp = nowMS;
 513:Core/Src/main.c ****     self->bms.valid = true;
 514:Core/Src/main.c **** 
 515:Core/Src/main.c ****     if (!isPlausible(self, value)) {
 516:Core/Src/main.c ****       controllerLatch(self, IMPLAUSIBLE_VOLTAGE);
 517:Core/Src/main.c ****       return;
 518:Core/Src/main.c ****     }
ARM GAS  /var/folders/mn/8b2ct_nd61b5t7v5g13ym6540000gn/T//ccMbGMJy.s 			page 32


 519:Core/Src/main.c ****     if (self->state == WAITING_FOR_BMS) {
 520:Core/Src/main.c ****       self->state = PRECHARGING;
 521:Core/Src/main.c ****       self->prechargingStartedMS = nowMS;
 522:Core/Src/main.c ****       self->hasPrechargingStartedMS = true;
 523:Core/Src/main.c ****     }
 524:Core/Src/main.c ****   } else if (matchSpec(frame, self->config.inverter)) {
 525:Core/Src/main.c ****     uint32_t value = 0;
 526:Core/Src/main.c ****     if (decodeVoltage(frame, self->config.inverter, &value) != OK) {
 527:Core/Src/main.c ****       controllerLatch(self, MALFORMED_FRAME);
 528:Core/Src/main.c ****       return;
 529:Core/Src/main.c ****     }
 530:Core/Src/main.c ****     self->inverter.value = value;
 531:Core/Src/main.c ****     self->inverter.timestamp = nowMS;
 532:Core/Src/main.c ****     self->inverter.valid = true;
 533:Core/Src/main.c **** 
 534:Core/Src/main.c ****     if (!isPlausible(self, value)) {
 535:Core/Src/main.c ****       controllerLatch(self, IMPLAUSIBLE_VOLTAGE);
 536:Core/Src/main.c ****       return;
 537:Core/Src/main.c ****     }
 538:Core/Src/main.c ****     controllerQualify(self, nowMS);
 539:Core/Src/main.c ****   }
 540:Core/Src/main.c **** }
